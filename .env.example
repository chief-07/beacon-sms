# ============================================================
# BeaconSMS Environment Configuration
# ============================================================

# --- Gateway Configuration (httpSMS) ---
# Your API Key from httpsms.com settings
HTTPSMS_API_KEY=your_httpsms_api_key_here

# The phone number in international format (+234...) assigned to your Android Gateway SIM
GATEWAY_PHONE_NUMBER=+2348000000000
SECONDARY_PHONE_NUMBER=
SECONDARY_HTTPSMS_API_KEY=

# Optional signing key configured in httpSMS webhook settings for JWT verification
HTTPSMS_SIGNING_KEY=

# --- AI Provider Configuration ---
# Options: "gemini" (recommended for multilingual speed), "groq" (~300ms ultra-low latency), "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-flash-latest,gemini-3.1-flash-lite-preview
GEMINI_TIMEOUT_SECONDS=12.0

# Groq API Key (Get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI API Key (Get from https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- SMS & Output Constraints ---
# Maximum characters to budget for SMS reply
MAX_SMS_CHARACTERS=280
# Send as single SMS (splitting disabled)
SMS_SPLIT_LONG_MESSAGES=false
SMS_SEGMENT_DELAY_SECONDS=1.5
# Self-loop block active for production
BLOCK_SELF_LOOP=true

# Keep in-memory conversation context for N minutes per phone number
CONVERSATION_TTL_MINUTES=20

# Number of past turns to retain per user
CONVERSATION_HISTORY_TURNS=3

# --- Server Settings ---
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
